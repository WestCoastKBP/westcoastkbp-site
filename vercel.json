{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(project-gallery|outdoor-solutions|bathroom-remodeling|indoor-renovation|models|compare|studio|service-areas)(/.*)?",
      "dest": "/retired.html",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "/(about|status)/?",
      "dest": "/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
